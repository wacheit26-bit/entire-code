/* ProductCard.css - Theme-Proof CSS with Complete Reset */
/* 
 * This CSS is designed to be completely independent of browser themes,
 * system preferences, and dark/light mode settings.
 * All colors, spacing, and styles are explicitly defined.
 */

/* Complete CSS Reset for Product Card */
.product-card,
.product-card *,
.product-card *::before,
.product-card *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Force hardware acceleration for consistent rendering */
.product-card {
  -webkit-transform: translateZ(0);
  transform: translateZ(0);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}

/* Explicit Color Variables - No reliance on system themes */
.product-card {
  /* Primary Colors - Explicit values */
  --card-primary: #0F172A;
  --card-primary-dark: #020617;
  --card-accent: #2563EB;
  --card-accent-dark: #1E40AF;
  --card-success: #10B981;
  --card-warning: #F59E0B;
  --card-danger: #EF4444;
  
  /* Neutral Colors - Fixed values */
  --card-white: #FFFFFF;
  --card-gray-50: #F9FAFB;
  --card-gray-100: #F3F4F6;
  --card-gray-200: #E5E7EB;
  --card-gray-300: #D1D5DB;
  --card-gray-400: #9CA3AF;
  --card-gray-500: #6B7280;
  --card-gray-600: #4B5563;
  --card-gray-700: #374151;
  --card-gray-800: #1F2937;
  --card-gray-900: #111827;
  --card-black: #000000;
  
  /* Shadows - Explicit values */
  --card-shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
  --card-shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  --card-shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  
  /* Transitions */
  --card-transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  
  /* Spacing */
  --card-spacing-xs: 4px;
  --card-spacing-sm: 8px;
  --card-spacing-md: 12px;
  --card-spacing-lg: 16px;
  
  /* Border Radius */
  --card-radius-sm: 4px;
  --card-radius-md: 6px;
  --card-radius-lg: 8px;
  --card-radius-xl: 12px;
}

/* Main Card Container - Fixed styling */
.product-card {
  background: var(--card-white);
  border-radius: var(--card-radius-xl);
  box-shadow: var(--card-shadow-sm);
  transition: var(--card-transition);
  overflow: hidden;
  position: relative;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  padding: var(--card-spacing-lg);
  gap: var(--card-spacing-lg);
  border: 1px solid var(--card-gray-200);
  /* Ensure consistent appearance across all browsers */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  line-height: 1.5;
  color: var(--card-gray-900);
}

.product-card:hover {
  box-shadow: var(--card-shadow-md);
  transform: translateY(-1px);
}

/* Image Area - Fixed */
.product-card__image-area {
  flex-shrink: 0;
  position: relative;
  width: 80px;
}

.product-card__image-container {
  width: 80px;
  height: 80px;
  border-radius: var(--card-radius-lg);
  overflow: hidden;
  background: var(--card-gray-50);
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.product-card__image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--card-gray-100), var(--card-gray-200));
  color: var(--card-gray-400);
}

.product-card__stock-badge {
  position: absolute;
  bottom: -6px;
  right: -6px;
  display: flex;
  align-items: center;
  gap: var(--card-spacing-xs);
  padding: 2px 6px;
  background: var(--card-white);
  border-radius: 12px;
  font-size: 10px;
  font-weight: 500;
  border: 1px solid var(--card-gray-200);
  box-shadow: var(--card-shadow-sm);
  white-space: nowrap;
  color: var(--card-gray-700);
}

/* Details Area - Fixed */
.product-card__details-area {
  flex: 2;
  min-width: 0;
}

.product-card__row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: var(--card-spacing-md);
  margin-bottom: var(--card-spacing-sm);
}

.product-card__title {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--card-gray-900);
  margin: 0;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: normal;
}

.product-card__price {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--card-primary);
  flex-shrink: 0;
  letter-spacing: -0.02em;
}

/* Specs Row - Fixed */
.product-card__specs-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--card-spacing-md);
  row-gap: var(--card-spacing-xs);
}

.spec {
  display: flex;
  align-items: center;
  gap: var(--card-spacing-sm);
  font-size: 0.75rem;
}

.spec-label {
  color: var(--card-gray-500);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.spec-value {
  color: var(--card-gray-700);
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: var(--card-spacing-xs);
}

.color-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  border: 1px solid var(--card-gray-300);
  flex-shrink: 0;
}

/* Actions Area - Fixed */
.product-card__actions-area {
  display: flex;
  align-items: center;
  gap: var(--card-spacing-sm);
  flex-shrink: 0;
}

/* Quantity Selector - Fixed */
.product-card__quantity {
  display: flex;
  align-items: center;
  border: 1px solid var(--card-gray-300);
  border-radius: var(--card-radius-md);
  overflow: hidden;
  background: var(--card-white);
}

.qty-btn {
  width: 28px;
  height: 28px;
  border: none;
  background: var(--card-gray-50);
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--card-transition);
  color: var(--card-gray-700);
  display: flex;
  align-items: center;
  justify-content: center;
}

.qty-btn:hover:not(:disabled) {
  background: var(--card-gray-200);
}

.qty-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.qty-value {
  min-width: 32px;
  text-align: center;
  font-size: 0.8125rem;
  font-weight: 500;
  padding: 0 var(--card-spacing-xs);
  color: var(--card-gray-900);
}

/* Action Buttons - Fixed */
.action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--card-spacing-sm);
  padding: 6px 12px;
  font-size: 0.75rem;
  font-weight: 600;
  border-radius: var(--card-radius-md);
  cursor: pointer;
  transition: var(--card-transition);
  border: none;
  font-family: inherit;
  white-space: nowrap;
  line-height: 1;
}

.action-btn--buy {
  background: var(--card-primary);
  color: var(--card-white);
}

.action-btn--buy:hover:not(:disabled) {
  background: var(--card-primary-dark);
}

.action-btn--offer {
  background: var(--card-white);
  color: var(--card-accent);
  border: 1px solid var(--card-accent);
}

.action-btn--offer:hover:not(:disabled) {
  background: var(--card-gray-50);
}

.action-btn--cart {
  background: var(--card-gray-900);
  color: var(--card-white);
}

.action-btn--cart:hover:not(:disabled) {
  background: var(--card-black);
}

.action-btn--loading {
  opacity: 0.7;
  cursor: wait;
}

.action-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Cart Toast - Fixed */
.cart-toast {
  position: absolute;
  bottom: -32px;
  right: var(--card-spacing-lg);
  padding: 4px 10px;
  background: var(--card-success);
  color: var(--card-white);
  font-size: 0.75rem;
  font-weight: 600;
  border-radius: var(--card-radius-md);
  animation: slideUp 0.2s ease;
  white-space: nowrap;
  z-index: 10;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Footer - Fixed */
.product-card__footer {
  position: absolute;
  bottom: var(--card-spacing-md);
  right: var(--card-spacing-lg);
  display: inline-flex;
  align-items: center;
  gap: var(--card-spacing-xs);
  padding: var(--card-spacing-xs) var(--card-spacing-sm);
  background: transparent;
  border: none;
  color: var(--card-gray-400);
  font-size: 0.6875rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--card-transition);
  font-family: inherit;
}

.product-card__footer:hover {
  color: var(--card-accent);
}

/* Stock Status - Fixed Colors */
.status--in { 
  color: var(--card-success);
}

.status--low { 
  color: var(--card-warning);
}

.status--out { 
  color: var(--card-danger);
}

.stock-badge {
  font-size: 0.6875rem;
  font-weight: 500;
}

/* Compact Variant - Fixed */
.product-card--compact {
  padding: 10px 12px;
  gap: var(--card-spacing-md);
}

.product-card--compact .product-card__image-wrapper {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.product-card--compact .product-card__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--card-spacing-xs);
}

.product-card--compact .product-card__title {
  font-size: 0.8125rem;
  white-space: normal;
}

.product-card--compact .product-card__price {
  font-size: 0.9375rem;
}

.product-card--compact .product-card__action-btn {
  padding: 4px 12px;
  font-size: 0.6875rem;
  background: var(--card-primary);
  color: var(--card-white);
  border: none;
  border-radius: var(--card-radius-md);
  cursor: pointer;
}

.product-card--compact .product-card__action-btn:hover:not(:disabled) {
  background: var(--card-primary-dark);
}

/* Modal Overlay - Fixed */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: var(--card-spacing-lg);
}

.modal-content {
  background: var(--card-white);
  border-radius: var(--card-radius-xl);
  padding: 20px;
  max-width: 320px;
  width: 100%;
  position: relative;
  box-shadow: var(--card-shadow-md);
  border: 1px solid var(--card-gray-200);
}

.modal-close {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 28px;
  height: 28px;
  border-radius: var(--card-radius-md);
  border: none;
  background: var(--card-gray-100);
  font-size: 1.25rem;
  cursor: pointer;
  color: var(--card-gray-700);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-title {
  margin: 0 0 var(--card-spacing-sm);
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--card-gray-900);
}

.modal-product {
  font-size: 0.8125rem;
  color: var(--card-gray-600);
  margin: 0 0 var(--card-spacing-xs);
}

.modal-price {
  font-size: 0.75rem;
  color: var(--card-gray-500);
  margin: 0 0 var(--card-spacing-lg);
}

.modal-content input {
  width: 100%;
  padding: 8px 12px;
  margin-bottom: var(--card-spacing-md);
  border: 1px solid var(--card-gray-300);
  border-radius: var(--card-radius-md);
  font-size: 0.875rem;
  font-family: inherit;
  background: var(--card-white);
  color: var(--card-gray-900);
}

.modal-content input:focus {
  outline: none;
  border-color: var(--card-accent);
  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1);
}

.modal-error {
  color: var(--card-danger);
  font-size: 0.75rem;
  margin: -8px 0 var(--card-spacing-md);
}

.modal-actions {
  display: flex;
  gap: var(--card-spacing-sm);
  justify-content: flex-end;
  margin-top: var(--card-spacing-sm);
}

.modal-actions button {
  padding: 6px 16px;
  border-radius: var(--card-radius-md);
  font-size: 0.8125rem;
  font-weight: 600;
  cursor: pointer;
  border: none;
  font-family: inherit;
}

.modal-actions button:first-child {
  background: var(--card-gray-100);
  color: var(--card-gray-700);
}

.modal-actions button:last-child {
  background: var(--card-accent);
  color: var(--card-white);
}

/* Responsive - Maintain consistency */
@media (max-width: 768px) {
  .product-card {
    flex-wrap: wrap;
    padding: var(--card-spacing-md);
  }
  
  .product-card__actions-area {
    width: 100%;
    justify-content: flex-start;
    margin-top: var(--card-spacing-xs);
  }
  
  .product-card__footer {
    position: static;
    width: 100%;
    justify-content: center;
    margin-top: var(--card-spacing-sm);
    padding-top: var(--card-spacing-sm);
    border-top: 1px solid var(--card-gray-200);
  }
  
  .product-card__specs-row {
    gap: var(--card-spacing-sm);
  }
}

@media (max-width: 640px) {
  .product-card__row {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--card-spacing-xs);
  }
  
  .product-card__actions-area {
    flex-wrap: wrap;
  }
  
  .action-btn {
    padding: 5px 10px;
  }
}

@media (max-width: 480px) {
  .product-card__image-area {
    width: 60px;
  }
  
  .product-card__image-container {
    width: 60px;
    height: 60px;
  }
  
  .spec {
    font-size: 0.6875rem;
  }
  
  .action-btn {
    padding: 4px 8px;
    font-size: 0.6875rem;
  }
}

/* Disable all system color schemes and forced colors */
@media (forced-colors: active) {
  .product-card,
  .product-card * {
    forced-color-adjust: none;
  }
}

/* Ensure consistent rendering on all browsers */
@supports (font-variation-settings: normal) {
  .product-card {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }
}

/* Remove any default button styles */
button.product-card__footer,
button.action-btn,
button.qty-btn,
button.modal-close,
button.product-card__action-btn {
  background: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
}

/* Ensure inputs don't inherit browser styles */
input {
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
}

/* Remove number input spinners */
input[type="number"]::-webkit-inner-spin-button,
input[type="number"]::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

input[type="number"] {
  -moz-appearance: textfield;
  appearance: textfield;
}