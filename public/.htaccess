<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave existing files and API routes untouched
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback — React Router handles /admin, /sales, /cart, etc. on refresh
  RewriteRule . /index.html [L]
</IfModule>
