# Optional: MongoDB _id used only as a DB foreign key for "not listed" preorders.
# VITE_PREORDER_PLACEHOLDER_PRODUCT_ID=

# Dual API failover (comma-separated origins; /api is added automatically if missing)
# Primary is listed first; backup is used when primary is slow or unreachable.
VITE_API_ORIGINS=https://wach.wacheelectronics.com,https://watcher3-u8aw.onrender.com

# Single origin (legacy — still works; backup defaults are merged in)
# VITE_API_ORIGIN=https://wach.wacheelectronics.com

# Local backend via Vite proxy (leave VITE_API_ORIGINS unset)
# VITE_API_ORIGIN=http://localhost:5000
